{
  "name": "form-easy-vue",
  "version": "0.1.0",
  "description": "form-easy 的 Vue 3 渲染器与 UI 组件库适配工具",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element-plus": {
      "types": "./dist/element-plus-basic-field-renderer.d.ts",
      "import": "./dist/element-plus-basic-field-renderer.js",
      "default": "./dist/element-plus-basic-field-renderer.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "form",
    "dynamic-form",
    "vue",
    "vue3",
    "element-plus",
    "form-easy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meteorzh/form-easy.git",
    "directory": "packages/form-easy-vue"
  },
  "bugs": {
    "url": "https://github.com/meteorzh/form-easy/issues"
  },
  "homepage": "https://github.com/meteorzh/form-easy#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "peerDependencies": {
    "form-easy": "^0.1.0",
    "vue": "^3.4.0",
    "element-plus": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    }
  },
  "devDependencies": {
    "form-easy": "file:../form-easy",
    "vue": "^3.5.0",
    "element-plus": "^2.14.5"
  },
  "license": "Apache-2.0"
}
