{
  "name": "@wenzhencn/form-easy",
  "version": "0.1.0",
  "description": "JSON 驱动的动态表单 Web Components，基于 Stencil 构建",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js",
      "require": "./dist/loader/index.cjs.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "form",
    "dynamic-form",
    "json-schema",
    "web-components",
    "stencil",
    "form-easy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meteorzh/form-easy.git",
    "directory": "packages/form-easy"
  },
  "bugs": {
    "url": "https://github.com/meteorzh/form-easy/issues"
  },
  "homepage": "https://github.com/meteorzh/form-easy#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --dev --watch",
    "test": "stencil test --spec",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@stencil/core": "^4.31.0"
  },
  "license": "Apache-2.0"
}
