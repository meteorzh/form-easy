{
  "key": "formEasyCreator",
  "name": "表单结构配置",
  "labelPosition": "top",
  "fields": [
    {
      "key": "formKey",
      "name": "表单 key",
      "category": "basic",
      "dataType": "string",
      "required": true,
      "hint": "用于生成字段完整唯一标识，不能包含点号或方括号。",
      "rules": [
        {
          "type": "pattern",
          "value": "^[^.\\[\\]\\s]+$",
          "message": "表单 key 不能包含空白、点号或方括号。"
        }
      ]
    },
    {
      "key": "formName",
      "name": "表单名称",
      "category": "basic",
      "dataType": "string",
      "required": true
    },
    {
      "key": "labelPosition",
      "name": "字段标签位置",
      "category": "basic",
      "dataType": "string",
      "component": "select",
      "componentData": [
        { "label": "左侧", "value": "left" },
        { "label": "顶部", "value": "top" },
        { "label": "右侧", "value": "right" }
      ]
    },
    {
      "key": "fieldDefinitions",
      "name": "字段配置列表",
      "category": "array",
      "required": true,
      "rules": [
        { "type": "minLength", "value": 1, "message": "请至少配置一个字段。" }
      ],
      "element": {
        "category": "object",
        "fields": [
          {
            "key": "key",
            "name": "字段 key",
            "category": "basic",
            "dataType": "string",
            "required": true,
            "rules": [
              {
                "type": "pattern",
                "value": "^[^.\\[\\]\\s]+$",
                "message": "字段 key 不能包含空白、点号或方括号。"
              }
            ]
          },
          {
            "key": "name",
            "name": "字段名称",
            "category": "basic",
            "dataType": "string",
            "required": true
          },
          {
            "key": "category",
            "name": "字段分类",
            "category": "basic",
            "dataType": "string",
            "component": "select",
            "componentData": [
              { "label": "基础字段", "value": "basic" },
              { "label": "数组字段", "value": "array" },
              { "label": "对象字段", "value": "object" }
            ],
            "required": true
          },
          {
            "key": "required",
            "name": "是否必填",
            "category": "basic",
            "dataType": "boolean"
          },
          {
            "key": "hint",
            "name": "字段提示",
            "category": "basic",
            "dataType": "string"
          },
          {
            "key": "dataType",
            "name": "基础字段数据类型",
            "category": "basic",
            "dataType": "string",
            "component": "select",
            "componentData": [
              { "label": "字符串", "value": "string" },
              { "label": "数字", "value": "number" },
              { "label": "布尔", "value": "boolean" },
              { "label": "日期", "value": "date" },
              { "label": "日期时间", "value": "datetime" },
              { "label": "时间", "value": "time" }
            ],
            "hint": "仅 category 为 basic 时生效。"
          },
          {
            "key": "component",
            "name": "自定义组件 key",
            "category": "basic",
            "dataType": "string",
            "hint": "留空时按照 dataType 使用渲染器默认组件。"
          },
          {
            "key": "componentDataKey",
            "name": "组件数据 key",
            "category": "basic",
            "dataType": "string"
          },
          {
            "key": "defaultValueJson",
            "name": "默认值 JSON",
            "category": "basic",
            "dataType": "string",
            "component": "creator-json-editor",
            "componentProperties": {
              "placeholder": "例如：\"默认文本\"、18、true 或 null",
              "rows": 3
            }
          },
          {
            "key": "componentPropertiesJson",
            "name": "组件属性 JSON",
            "category": "basic",
            "dataType": "string",
            "component": "creator-json-editor",
            "componentProperties": {
              "placeholder": "例如：{ \"placeholder\": \"请输入\" }",
              "rows": 4
            },
            "hint": "仅基础字段生效，内容必须是 JSON 对象。"
          },
          {
            "key": "componentDataJson",
            "name": "组件静态数据 JSON",
            "category": "basic",
            "dataType": "string",
            "component": "creator-json-editor",
            "componentProperties": {
              "placeholder": "例如：[{ \"label\": \"启用\", \"value\": \"enabled\" }]",
              "rows": 4
            }
          },
          {
            "key": "elementJson",
            "name": "数组元素定义 JSON",
            "category": "basic",
            "dataType": "string",
            "component": "creator-json-editor",
            "componentProperties": {
              "placeholder": "例如：{ \"category\": \"basic\", \"dataType\": \"string\" }",
              "rows": 5
            },
            "hint": "仅 category 为 array 时生效；元素定义不包含 key 和 name。",
            "binds": [
              {
                "sourceFormKey": "formEasyCreator",
                "sourceFieldId": "./category",
                "target": "visible",
                "resolver": "return sourceFieldValue === 'array';"
              }
            ]
          },
          {
            "key": "fieldsJson",
            "name": "对象子字段列表 JSON",
            "category": "basic",
            "dataType": "string",
            "component": "creator-json-editor",
            "componentProperties": {
              "placeholder": "例如：[{ \"key\": \"city\", \"name\": \"城市\", \"category\": \"basic\", \"dataType\": \"string\" }]",
              "rows": 6
            },
            "hint": "仅 category 为 object 时生效。",
            "binds": [
              {
                "sourceFormKey": "formEasyCreator",
                "sourceFieldId": "./category",
                "target": "visible",
                "resolver": "return sourceFieldValue === 'object';"
              }
            ]
          },
          {
            "key": "rules",
            "name": "校验规则列表",
            "category": "array",
            "element": {
              "category": "object",
              "fields": [
                {
                  "key": "type",
                  "name": "规则类型",
                  "category": "basic",
                  "dataType": "string",
                  "component": "select",
                  "componentData": [
                    { "label": "minLength", "value": "minLength" },
                    { "label": "maxLength", "value": "maxLength" },
                    { "label": "min", "value": "min" },
                    { "label": "max", "value": "max" },
                    { "label": "pattern", "value": "pattern" },
                    { "label": "enum", "value": "enum" }
                  ],
                  "required": true
                },
                {
                  "key": "valueJson",
                  "name": "规则值 JSON",
                  "category": "basic",
                  "dataType": "string",
                  "hint": "字符串和正则需要使用 JSON 双引号。"
                },
                {
                  "key": "message",
                  "name": "错误提示",
                  "category": "basic",
                  "dataType": "string"
                }
              ]
            }
          },
          {
            "key": "binds",
            "name": "字段绑定列表",
            "category": "array",
            "element": {
              "category": "object",
              "fields": [
                {
                  "key": "sourceFormKey",
                  "name": "绑定源表单 key",
                  "category": "basic",
                  "dataType": "string",
                  "required": true
                },
                {
                  "key": "sourceFieldId",
                  "name": "绑定源字段完整标识",
                  "category": "basic",
                  "dataType": "string",
                  "required": true
                },
                {
                  "key": "target",
                  "name": "绑定目标",
                  "category": "basic",
                  "dataType": "string",
                  "component": "select",
                  "componentData": [
                    { "label": "visible", "value": "visible" },
                    { "label": "enable", "value": "enable" },
                    { "label": "value", "value": "value" }
                  ],
                  "required": true
                },
                {
                  "key": "resolver",
                  "name": "布尔值 resolver",
                  "category": "basic",
                  "dataType": "string",
                  "component": "creator-json-editor",
                  "componentProperties": {
                    "placeholder": "例如：return sourceFieldValue === 'enabled';",
                    "rows": 3
                  }
                }
              ]
            }
          },
          {
            "key": "eventSubscriptions",
            "name": "事件订阅列表",
            "category": "array",
            "element": {
              "category": "object",
              "fields": [
                {
                  "key": "sourceFormKey",
                  "name": "事件源表单 key",
                  "category": "basic",
                  "dataType": "string",
                  "required": true
                },
                {
                  "key": "sourceFieldKey",
                  "name": "事件源字段完整标识",
                  "category": "basic",
                  "dataType": "string",
                  "required": true
                },
                {
                  "key": "eventName",
                  "name": "事件名",
                  "category": "basic",
                  "dataType": "string",
                  "component": "select",
                  "componentData": [
                    { "label": "onChange", "value": "onChange" },
                    { "label": "onShow", "value": "onShow" },
                    { "label": "onHide", "value": "onHide" },
                    { "label": "onDisabled", "value": "onDisabled" },
                    { "label": "onEnabled", "value": "onEnabled" },
                    { "label": "onClear", "value": "onClear" }
                  ],
                  "required": true
                },
                {
                  "key": "handle",
                  "name": "目标操作",
                  "category": "basic",
                  "dataType": "string",
                  "component": "select",
                  "componentData": [
                    { "label": "show", "value": "show" },
                    { "label": "hide", "value": "hide" },
                    { "label": "disable", "value": "disable" },
                    { "label": "enable", "value": "enable" },
                    { "label": "clear", "value": "clear" },
                    { "label": "change", "value": "change" }
                  ],
                  "required": true
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
